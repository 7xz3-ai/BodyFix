# BodyFix Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Resend API Key — get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal email to receive booking notifications
ADMIN_EMAIL=you@example.com

# The "from" email address for outgoing emails
# IMPORTANT: This domain must be verified in your Resend dashboard
# See: https://resend.com/domains
FROM_EMAIL=bookings@bodyfixosteo.com
